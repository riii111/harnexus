{
  "name": "harnexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "check": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "doctor": "bun --no-env-file --config=/dev/null src/bootstrap/doctor.ts",
    "open-app": "bun --no-env-file --config=/dev/null src/bootstrap/open-app.ts",
    "call": "bun --no-env-file --config=/dev/null src/bootstrap/call.ts",
    "task": "bun --no-env-file --config=/dev/null src/bootstrap/task/main.ts",
    "build:task": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/bootstrap/task/main.ts --outfile dist/harnexus-task",
    "install:task": "bun run build:task && mkdir -p \"$HOME/.local/bin\" && install -m 0755 dist/harnexus-task \"$HOME/.local/bin/.harnexus-task.tmp\" && mv -f \"$HOME/.local/bin/.harnexus-task.tmp\" \"$HOME/.local/bin/harnexus-task\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-result": "3.0.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "zod": "4.4.3"
  }
}
