{
  "name": "harnexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "oxfmt --check && oxlint --deny-warnings",
    "diagnose:complexity": "oxlint -c .oxlintrc.complexity.json src",
    "check:readme": "bash scripts/check-readme.sh",
    "format": "oxfmt && oxlint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "doctor": "bun --no-env-file --config=/dev/null src/cli/doctor.ts",
    "feedback": "bun --no-env-file --config=/dev/null src/cli/feedback.ts",
    "open-app": "bun --no-env-file --config=/dev/null src/cli/open-app.ts",
    "call": "bun --no-env-file --config=/dev/null src/cli/call.ts",
    "task": "bun --no-env-file --config=/dev/null src/cli/task.ts",
    "build:task": "bun --no-env-file --config=/dev/null src/cli/check-bun.ts && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/cli/task.ts --outfile dist/harnexus-task",
    "install:task:cloud": "bash scripts/install-cloud-task.sh",
    "install:task": "bun run build:task && mkdir -p \"$HOME/.local/bin\" && install -m 0755 dist/harnexus-task \"$HOME/.local/bin/.harnexus-task.tmp\" && mv -f \"$HOME/.local/bin/.harnexus-task.tmp\" \"$HOME/.local/bin/harnexus-task\""
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317",
    "@modelcontextprotocol/sdk": "1.30.1",
    "better-result": "3.0.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "zod": "4.4.3"
  }
}
